{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "extensions/**/*.ts",
    "lib/**/*.ts",
    "test/**/*.ts",
    "installer/**/*.mjs",
    "paperclip/src/**/*.ts",
    "paperclip/test/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules", "paperclip/dist", "paperclip/src/plugin/**"]
}
