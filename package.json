{
  "name": "ultimate-pi",
  "version": "1.2.0-alpha",
  "description": "Multi-agent routing for the Pi CLI.",
  "type": "module",
  "license": "MIT",
  "repository": "github:VisionCraft3r/ultimate-pi",
  "keywords": [
    "pi-package",
    "pi",
    "ai-agents",
    "multi-agent"
  ],
  "bin": {
    "ultimate-pi": "bin/ultimate-pi.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/jev-triage.ts",
      "./extensions/jev-sentinel.ts",
      "./extensions/quota-fallback.ts",
      "./extensions/model-agents.ts",
      "./extensions/agent-config.ts",
      "./extensions/planner-handoff.ts",
      "./extensions/custom-header.ts",
      "./extensions/session-chrome.ts",
      "./extensions/ask-user-question.ts",
      "./extensions/scout-budget.ts",
      "./extensions/qa-budget.ts",
      "./extensions/paperclip-mirror.ts",
      "./extensions/paperclip-subagent-hold.ts",
      "./extensions/launch-update.ts",
      "./extensions/wave-diff.ts",
      "./extensions/review-trace.ts",
      "./extensions/bash-guard/index.ts",
      "./extensions/browser/index.ts",
      "./extensions/prompt-snippets/index.ts",
      "./extensions/web-fetch/index.ts",
      "./extensions/web-search/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": []
  },
  "files": [
    "bin",
    "installer",
    "extensions",
    "extras",
    "lib",
    "skills",
    "templates",
    "patches",
    "assets",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@mozilla/readability": "^0.5.0",
    "linkedom": "^0.16.0",
    "playwright-core": "^1.49.0",
    "shell-quote": "^1.8.3",
    "turndown": "^7.2.0",
    "unpdf": "^1.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "scan": "node scripts/scan-secrets.mjs && node scripts/scan-personal.mjs && node scripts/check-context-budget.mjs",
    "measure:startup": "node scripts/measure-startup.mjs",
    "smoke": "node scripts/smoke-install.mjs"
  }
}
