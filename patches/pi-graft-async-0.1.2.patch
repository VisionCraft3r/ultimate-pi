+/** Async JSON call. A timeout or a missing graph resolves to null and never throws. */
+function graftJsonAsync(dir: string, args: string[], timeout: number): Promise<any | null> {
+  return new Promise((resolve) => {
+    const full = withContextDirArg(dir, args);
+    execFile(
+      GRAFT_BIN,
+      full,
+      { cwd: dir, encoding: "utf8", timeout, maxBuffer: 10 * 1024 * 1024 },
+      (_err, stdout) => {
+        const text = String(stdout ?? "").trim();
+        if (!text) {
+          resolve(null);
+          return;
+        }
+        try { resolve(JSON.parse(text)); }
+        catch { resolve(null); }
+      },
+    );
+  });
+}
+
+/** Resolve with the value, or null if the budget elapses first. The work keeps running. */
+function withBudget<T>(work: Promise<T>, budgetMs: number): Promise<T | null> {
+  return new Promise((resolve) => {
+    const timer = setTimeout(() => resolve(null), budgetMs);
+    work.then(
+      (value) => {
+        clearTimeout(timer);
+        resolve(value);
+      },
+      () => {
+        clearTimeout(timer);
+        resolve(null);
+      },
+    );
+  });
 }
 
