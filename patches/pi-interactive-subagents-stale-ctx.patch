+function deliverToParent(
+  pi: { sendMessage: (message: any, options?: any) => void } | null | undefined,
+  message: any,
+  options?: any,
+): boolean {
+  try {
+    pi?.sendMessage(message, options);
+    return true;
+  } catch (err) {
+    const text = err instanceof Error ? err.message : String(err);
+    if (text.includes("stale after session replacement or reload")) {
+      latestPi = null;
+      latestCtx = null;
+    }
+    // A replaced session cannot take a steer. The child session file still has the result.
+    return false;
+  }
+}
