+/**
+ * Resume should follow a global agent-model edit made after the spawn snapshot
+ * was written. Tools, identity, cwd, and the spawn whitelist stay on that snapshot.
+ * A missing profile keeps the snapshotted model.
+ */
+function withGlobalAgentModel(loadout: SubagentLoadout): SubagentLoadout {
+  if (!loadout.agent) return loadout;
+  const profilePath = join(getAgentConfigDir(), "agents", `${loadout.agent}.md`);
+  if (!existsSync(profilePath)) return loadout;
+  const parsed = parseAgentDefinition(readFileSync(profilePath, "utf8"), loadout.agent);
+  if (!parsed) return loadout;
+  return {
+    ...loadout,
+    model: parsed.model || loadout.model,
+    thinking: parsed.thinking || loadout.thinking,
+  };
+}
